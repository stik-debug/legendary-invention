{
  "name": "chamapay",
  "version": "1.1.0",
  "description": "ChamaPay - Production Kenyan Chama Management SaaS",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx src/scripts/smoke-auth-chama.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1",
    "typescript": "^5.7.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}